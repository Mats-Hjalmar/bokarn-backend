# Local development defaults. Copy to .env — `make dev` does this for you.
# Every value here is a dev credential; nothing in this file is a secret.

BOKARN_PORT=1437

BOKARN_DB_HOST=localhost
BOKARN_DB_PORT=1438
BOKARN_DB_NAME=bokarn
BOKARN_DB_SSLMODE=disable

# The three roles are not interchangeable. cmd/api and cmd/job connect as the
# app role, which must never bypass row-level security; cmd/migrate connects as
# the migrator, which owns the schema.
BOKARN_DB_APP_USER=bokarn_app
BOKARN_DB_APP_PASSWORD=bokarn_app
BOKARN_DB_MIGRATOR_USER=bokarn_migrator
BOKARN_DB_MIGRATOR_PASSWORD=bokarn_migrator
BOKARN_DB_PLATFORM_USER=bokarn_platform
BOKARN_DB_PLATFORM_PASSWORD=bokarn_platform

BOKARN_REDIS_HOST=localhost
BOKARN_REDIS_PORT=1439

BOKARN_KRATOS_PUBLIC_URL=http://auth.bokarn.localhost
BOKARN_KRATOS_ADMIN_URL=http://auth-admin.bokarn.localhost
BOKARN_KRATOS_STAFF_PUBLIC_URL=http://auth-staff.bokarn.localhost
BOKARN_KRATOS_STAFF_ADMIN_URL=http://auth-staff-admin.bokarn.localhost

OTEL_SERVICE_NAME=bokarn-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://otlp.bokarn.localhost
OTEL_EXPORTER_OTLP_INSECURE=true

BOKARN_SMTP_HOST=localhost
BOKARN_SMTP_PORT=1425

BOKARN_LOG_LEVEL=info
BOKARN_LOG_FORMAT=text

# Reserved. Payments are not implemented yet and nothing reads these; they are
# here so the variable names are settled before the code that needs them.
BOKARN_STRIPE_SECRET_KEY=
BOKARN_STRIPE_WEBHOOK_SECRET=
